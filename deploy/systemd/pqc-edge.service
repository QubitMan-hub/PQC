[Unit]
Description=pqc edge: post-quantum TLS in front of local services
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pqc/edge.toml

[Service]
User=pqc
ExecStart=/opt/pqc/bin/pqc tls edge --config /etc/pqc/edge.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
# two open files per connection: room for about 30,000 connections per process
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=pqc/edge
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
